{
  "name": "microjobs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server"
  ],
  "main": "Mobile/index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check-node": "node scripts/check-node.cjs",
    "check:dependencies": "node scripts/check-dependencies.cjs",
    "predev": "npm run check:dependencies",
    "dev": "node scripts/run-with-node.cjs node scripts/dev.cjs",
    "dev:tunnel": "node scripts/run-with-node.cjs node scripts/dev.cjs --tunnel",
    "dev:server": "npm --prefix server run dev",
    "predev:client": "npm run check:dependencies",
    "dev:client": "node scripts/run-with-node.cjs node node_modules/vite/bin/vite.js --config client/vite.config.ts",
    "mobile:start": "npm --prefix Mobile run start",
    "mobile:start:clear": "npm --prefix Mobile run start:clear",
    "mobile:android": "npm --prefix Mobile run android",
    "mobile:ios": "npm --prefix Mobile run ios",
    "mobile:web": "npm --prefix Mobile run web",
    "start": "npm --prefix server start",
    "build": "npm run build:client",
    "prebuild:client": "npm run check:dependencies",
    "build:client": "node scripts/run-with-node.cjs node scripts/check-node.cjs && node scripts/run-with-node.cjs node node_modules/typescript/bin/tsc -p client/tsconfig.json && node scripts/run-with-node.cjs node node_modules/vite/bin/vite.js build --config client/vite.config.ts",
    "typecheck:web": "node scripts/run-with-node.cjs node node_modules/typescript/bin/tsc -p client/tsconfig.json --noEmit",
    "typecheck:mobile": "npm run typecheck --prefix Mobile",
    "check:mobile-theme": "npm run check:theme --prefix Mobile",
    "check:mobile-auth-accessibility": "npm run check:auth-accessibility --prefix Mobile",
    "check:ui-security": "node scripts/check-ui-security.mjs",
    "check:security": "node scripts/check-security.mjs",
    "lint": "eslint client/src Mobile server scripts *.config.*",
    "lint:all": "eslint client/src Mobile server scripts *.config.*",
    "test:server": "npm test --prefix server",
    "test:e2e": "playwright test",
    "verify": "npm run check:security && npm run check:mobile-theme && npm run check:mobile-auth-accessibility && npm run lint && npm run typecheck:web && npm run typecheck:mobile && npm run test:server && npm run build",
    "verify:full": "npm run verify && npm run test:e2e",
    "preview": "node scripts/run-with-node.cjs node node_modules/vite/bin/vite.js preview --config client/vite.config.ts",
    "seed:superadmin": "node server/scripts/seedSuperAdmin.js",
    "seed:demo-user": "node server/scripts/seedDemoUser.js",
    "seed:alerts": "node server/scripts/seedAlerts.js"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.13.5",
    "lucide-react": "^0.487.0",
    "motion": "*",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.18.2",
    "recharts": "^2.15.2",
    "socket.io-client": "^4.8.3",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@types/node": "^20.0.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.3.4",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.1"
  }
}
