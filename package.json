{
  "name": "microjobs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "Mobile/index.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check-node": "node scripts/check-node.cjs",
    "dev": "npm run dev:server",
    "dev:server": "node scripts/run-with-node.cjs nodemon server/index.js",
    "dev:client": "node scripts/run-with-node.cjs vite --config client/vite.config.ts",
    "mobile:start": "node scripts/run-with-node.cjs expo start",
    "mobile:android": "node scripts/run-with-node.cjs expo start --android",
    "mobile:ios": "node scripts/run-with-node.cjs expo start --ios",
    "mobile:web": "node scripts/run-with-node.cjs expo start --web",
    "start": "node scripts/run-with-node.cjs node server/index.js",
    "build": "npm run build:client",
    "build:client": "node scripts/check-node.cjs && node scripts/run-with-node.cjs tsc -p client/tsconfig.json && node scripts/run-with-node.cjs vite build --config client/vite.config.ts",
    "preview": "node scripts/run-with-node.cjs vite preview --config client/vite.config.ts",
    "seed:superadmin": "node server/scripts/seedSuperAdmin.js",
    "seed:demo-user": "node server/scripts/seedDemoUser.js",
    "seed:alerts": "node server/scripts/seedAlerts.js"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "expo": "~54.0.31",
    "expo-status-bar": "~3.0.9",
    "express": "^5.2.1",
    "google-auth-library": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.487.0",
    "mongoose": "^9.1.3",
    "morgan": "^1.10.1",
    "motion": "*",
    "nodemailer": "^8.0.0",
    "react": "19.1.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-router-dom": "^7.12.0",
    "recharts": "^2.15.2",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "*",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.23",
    "babel-preset-expo": "^54.0.10",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.3.4",
    "vite": "^7.3.1"
  }
}
