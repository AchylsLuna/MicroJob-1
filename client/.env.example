VITE_API_BASE=http://localhost:5050/api
VITE_SOCKET_URL=http://localhost:5050/
VITE_API_PROXY_TARGET=http://localhost:5050
# Leave unset locally. Set `bearer` only for unrelated HTTPS web/API hosts,
# such as Azure Static Web Apps plus App Service default URLs.
VITE_AUTH_TRANSPORT=
# Public OAuth 2.0 Web client ID from Google Cloud Console (not a secret).
VITE_GOOGLE_CLIENT_ID=

# Production examples:
# Same origin: VITE_API_BASE=/api and omit VITE_SOCKET_URL.
# Split hosts: VITE_API_BASE=https://api.example.com/api
#              VITE_SOCKET_URL=https://api.example.com
