# Runtime
NODE_ENV=development
PORT=5050

# MongoDB
# Required in production. Keep credentials in the deployment provider, not Git.
MONGO_URI=
MONGODB_URI=
DB_NAME=MicroJob
ENABLE_IN_MEMORY_MONGO=true

# Frontend URLs, CORS, and reverse-proxy behavior
CLIENT_ORIGIN=http://localhost:8082
ADDITIONAL_CORS_ORIGINS=
WEB_ORIGIN=http://localhost:8082
FRONTEND_URL=http://localhost:8082
ORIGIN=http://localhost:8082
# Optional public HTTPS origin for web reset emails, e.g.
# https://micro-job-1.vercel.app or your verified custom domain. Leave blank
# on Vercel to use its canonical VERCEL_PROJECT_PRODUCTION_URL automatically.
APP_RESET_URL=
# Mobile reset-link configuration is separate from web email links.
MOBILE_RESET_URL=
# Optional HTTPS PNG/JPEG logo URL. Gmail-safe CSS branding is used when unset.
EMAIL_LOGO_URL=
TRUST_PROXY=false

# Authentication and cookies
#cryptographically random value of at least 64 bytes in production.
JWT_SECRET=
# For split same-site hosts, use the shared parent (example: .example.com).
# Leave empty for a same-origin deployment.
COOKIE_DOMAIN=
# Cookie-authenticated state changes use this same CSRF cookie/header contract.
ENABLE_CSRF=true
CSRF_COOKIE_NAME=csrfToken
# Browser requests with x-microjobs-auth-transport=bearer receive rotating
# tokens in their response body. Use this only for unrelated HTTPS web/API
# origins (such as the Azure default hosts); local sessions keep using cookies.
# OAuth 2.0 Web client ID; must match the frontend VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Optional native client IDs from the same Google Cloud project. The Android
# client must use package com.bananas1.mobile and the APK's SHA-1 certificate.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Email
# Preferred: a transactional provider. Consumer mailboxes (Gmail etc.) silently
# drop verification-code emails sent from an unauthenticated personal account.
# Set RESEND_API_KEY and MAIL_FROM to use Resend; it takes priority over SMTP.
RESEND_API_KEY=
MAIL_FROM=
# Fallback: raw SMTP. Used only when RESEND_API_KEY is unset.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPPORT_ALERT_EMAILS=
ALERTS_EMAIL=
# Protects scheduled endpoints; set the same high-entropy value in Vercel.
# Long-running API servers also check pending long-term daily payments every 12
# hours. Serverless /api/cron/daily-payment-reminders uses CRON_SECRET below.
# The 15-minute payment reminder schedule sends reminders at 3, 5, and 24
# hours after work submission and requires a Vercel plan that supports crons.
CRON_SECRET=

# Phone verification (Textbee). Create TEXTBEE_API_KEY in the Textbee dashboard.
# TEXTBEE_DEVICE_ID is optional: omit it to use the account's default enabled device.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Avatar storage. Azure is the primary store when the connection string is
# present; MongoDB StoredUpload remains the automatic fallback/backup.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=avatars
# Required for completion images. Use an existing private container; never expose this connection string to clients.
AZURE_EVIDENCE_CONNECTION_STRING=""
AZURE_EVIDENCE_CONTAINER_NAME=""
# Payments
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
XENDIT_SECRET_KEY=
XENDIT_PAYMENT_LINK_URL=
# AES-256-GCM key material for QR settlement invoice codes
# (controllers/QrSettlementController.js). When unset the cipher key is derived
# from JWT_SECRET, which reuses one secret across two unrelated cryptosystems --
# set this to an independent random value so rotating one does not affect the
# other.
QR_INVOICE_SECRET=
TOPUP_MIN_AMOUNT=100
TOPUP_MAX_AMOUNT=1000000
ALLOW_DEV_WEBHOOK=false

# ID verification (KYC) -- controllers/IdAnalyzerController.js
# Without IDANALYZER_KEY the ID scanning endpoint is disabled.
IDANALYZER_KEY=
KYC_PROFILE_ID=

# Optional local/demo seeding
AUTO_SEED_SUPERADMIN=false
SUPERADMIN_EMAIL=jomasenriquez2004@gmail.com
SUPERADMIN_USERNAME=Adminjobhandle
SUPERADMIN_PASSWORD=Admin123.
SUPERADMIN_RESET_PASSWORD=false
AUTO_SEED_DEMO_USER=false
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_USER_RESET_PASSWORD=false
DEMO_USER_ROLE=work
SEED_VERBOSE=false
ENABLE_PAYMENT_DISPUTE_DEMO_SEED=false
PAYMENT_DISPUTE_DEMO_PASSWORD=
PAYMENT_DISPUTE_DEMO_EMPLOYER_EMAIL=payment-demo-employer@microjobs.local
PAYMENT_DISPUTE_DEMO_WORKER_EMAIL=payment-demo-worker@microjobs.local

# Monitoring thresholds
ALERT_FAILURE_WINDOW_SEC=300
ALERT_FAILURE_THRESHOLD=10
ALERT_TOPUP_WINDOW_SEC=300
ALERT_TOPUP_THRESHOLD=10

# Production messaging
MESSAGE_MAX_LENGTH=4000
MESSAGE_RATE_WINDOW_MS=60000
MESSAGE_RATE_LIMIT=30
SOCKET_MAX_CONNECTIONS_PER_USER=5
SOCKET_MAX_CONNECTIONS_PER_IP=20
SOCKET_RATE_WINDOW_MS=60000
SOCKET_RATE_LIMIT=60

# Legacy automatic transfer reconciliation only; new withdrawals require Finance approval.
AUTOMATIC_WITHDRAWALS_ENABLED=false
PAYMONGO_WALLET_ID=
PAYMONGO_TRANSFER_CALLBACK_URL=
PAYMONGO_TRANSFER_WEBHOOK_SECRET=
# Protects POST /api/maintenance; also set this secret in GitHub Actions.
MAINTENANCE_SECRET=

# Project policy values in PHP, not statutory/regulatory limits.
# Both wallets default to PHP 50 minimum and PHP 50,000 maximum. 0 maximum = available balance.
WITHDRAWAL_MIN_AMOUNT=50
WITHDRAWAL_EMPLOYER_MAX_AMOUNT=50000
WITHDRAWAL_WORKER_MAX_AMOUNT=50000
# Legacy policy snapshot compatibility; all new withdrawals require Finance approval.
WITHDRAWAL_REVIEW_THRESHOLD=50000
# Escalation alerts senior reviewers only; it never distributes held funds.
# The evidence deadline must also pass before escalation. Applies to existing open cases.
FINANCIAL_DISPUTE_REVIEW_HOURS=168
