# Runtime
NODE_ENV=development
PORT=5050

# MongoDB
# Required in production. Keep credentials in the deployment provider, not Git.
MONGO_URI=
MONGODB_URI=
DB_NAME=MicroJob
ENABLE_IN_MEMORY_MONGO=true

# Frontend URLs, CORS, and reverse-proxy behavior
CLIENT_ORIGIN=http://localhost:8082
ADDITIONAL_CORS_ORIGINS=
WEB_ORIGIN=http://localhost:8082
FRONTEND_URL=http://localhost:8082
ORIGIN=http://localhost:8082
# Use the public HTTPS host for reset emails. Configure this host as an
# iOS Universal Link / Android App Link to open the installed app.
APP_RESET_URL=https://m1cro-job.vercel.app/reset-password
# Optional HTTPS PNG/JPEG logo URL. Gmail-safe CSS branding is used when unset.
EMAIL_LOGO_URL=
TRUST_PROXY=false

# Authentication and cookies
#cryptographically random value of at least 64 bytes in production.
JWT_SECRET=
# For split same-site hosts, use the shared parent (example: .example.com).
# Leave empty for a same-origin deployment.
COOKIE_DOMAIN=
# Cookie-authenticated state changes use this same CSRF cookie/header contract.
ENABLE_CSRF=true
CSRF_COOKIE_NAME=csrfToken

# Email
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SUPPORT_ALERT_EMAILS=
ALERTS_EMAIL=

# SMS OTP
# Use development only for local testing; production must use twilio.
PHONE_OTP_PROVIDER=development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
PHONE_OTP_DEFAULT_COUNTRY_CODE=+63
PHONE_OTP_TTL_MS=300000
PHONE_OTP_MAX_ATTEMPTS=5
PHONE_OTP_RESEND_COOLDOWN_MS=60000
PHONE_OTP_EXPOSE_CODE=false

# Payments
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
XENDIT_SECRET_KEY=
XENDIT_PAYMENT_LINK_URL=
TOPUP_MIN_AMOUNT=100
TOPUP_MAX_AMOUNT=1000000
ALLOW_DEV_WEBHOOK=false

# Optional local/demo seeding
AUTO_SEED_SUPERADMIN=false
SUPERADMIN_EMAIL=jomasenriquez2004@gmail.com
SUPERADMIN_USERNAME=Adminjobhandle
SUPERADMIN_PASSWORD=Admin123.
SUPERADMIN_RESET_PASSWORD=false
AUTO_SEED_DEMO_USER=false
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_USER_RESET_PASSWORD=false
DEMO_USER_ROLE=work
SEED_VERBOSE=false

# Monitoring thresholds
ALERT_FAILURE_WINDOW_SEC=300
ALERT_FAILURE_THRESHOLD=10
ALERT_TOPUP_WINDOW_SEC=300
ALERT_TOPUP_THRESHOLD=10

# Production messaging
MESSAGE_MAX_LENGTH=4000
MESSAGE_RATE_WINDOW_MS=60000
MESSAGE_RATE_LIMIT=30
SOCKET_MAX_CONNECTIONS_PER_USER=5
SOCKET_MAX_CONNECTIONS_PER_IP=20
SOCKET_RATE_WINDOW_MS=60000
SOCKET_RATE_LIMIT=60
