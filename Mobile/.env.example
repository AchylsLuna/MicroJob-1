EXPO_PUBLIC_API_URL=https://micro-job-1.vercel.app/api
EXPO_PUBLIC_SOCKET_URL=
EXPO_PUBLIC_API_TIMEOUT_MS=12000

# For local Expo testing, leave EXPO_PUBLIC_API_URL unset. The launcher detects
# the computer's current LAN IP on every start. Do not use 0.0.0.0 as a client
# destination; it is only the address the API server binds to.
# For remote testing, set it to the deployed API, for example:
# EXPO_PUBLIC_API_URL=https://micro-job-1.vercel.app/api
