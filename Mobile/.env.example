# Leave this unset for local Expo development so the launcher selects the
# computer's LAN address and the same local MongoDB-backed API used by web.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:5050/api
EXPO_PUBLIC_SOCKET_URL=
EXPO_PUBLIC_SOCKET_PATH=
# Local Expo Go derives its API origin from the QR host when this is set.
# EXPO_PUBLIC_API_SOURCE=development-metro-proxy
EXPO_PUBLIC_API_TIMEOUT_MS=12000

# For local Expo testing, leave EXPO_PUBLIC_API_URL unset. The launcher detects
# the computer's current LAN IP on every start. Do not use 0.0.0.0 as a client
# destination; it is only the address the API server binds to.
# For remote testing, set it to the deployed API, for example:
# For an intentional production-device test instead, uncomment:
# EXPO_PUBLIC_API_URL=https://m1cro-job.vercel.app/api
