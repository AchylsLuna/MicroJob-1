{
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://microjobs-api-test.azurewebsites.net/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://microjobs-api-test.azurewebsites.net",
        "EXPO_PUBLIC_SOCKET_PATH": "/socket.io",
        "EXPO_PUBLIC_API_TIMEOUT_MS": "30000"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://microjobs-api-test.azurewebsites.net/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://microjobs-api-test.azurewebsites.net",
        "EXPO_PUBLIC_SOCKET_PATH": "/socket.io",
        "EXPO_PUBLIC_API_TIMEOUT_MS": "30000"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}